rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Get user profile
    function getUserRole() {
       let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid));
       return userProfile != null ? userProfile.data.role : 'standard';
    }

    // Users Collection: Users can read/write their own profile, Admins can read/write all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');
      allow write: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');
    }

    // Projects Collection
    match /projects/{projectId} {
      // READ: Authenticated users can read projects (filter by owner in query)
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      
      // CREATE: Standard or Pro users
      allow create: if request.auth != null && 
                    (getUserRole() == 'standard' || getUserRole() == 'pro') &&
                    request.resource.data.userId == request.auth.uid;

      // UPDATE/DELETE: Standard or Pro users who own the project
      allow update, delete: if request.auth != null && 
                            (getUserRole() == 'standard' || getUserRole() == 'pro') &&
                            resource.data.userId == request.auth.uid;
    }
  }
}

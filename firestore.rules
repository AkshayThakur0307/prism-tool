rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Get user's role safely (handles missing doc or missing field)
    function getUserRole() {
       let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid));
       return userProfile != null ? userProfile.data.get('role', 'standard') : 'standard';
    }

    // Users Collection: Users can read/write own profile, Admin can read/write ALL
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');
      allow write: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');
    }

    // Projects Collection
    match /projects/{projectId} {
      // READ: Owner OR in sharedWith list
      allow read: if request.auth != null && (
        (resource == null || resource.data.userId == request.auth.uid) || 
        (resource.data.sharedWith != null && request.auth.uid in resource.data.sharedWith)
      );
      
      // CREATE: Authenticated users with valid role
      allow create: if request.auth != null && 
                    (getUserRole() in ['standard', 'pro', 'admin']) &&
                    request.resource.data.userId == request.auth.uid;

      // UPDATE/DELETE: Owner only + Role Check (Shared users cannot update/delete)
      allow update, delete: if request.auth != null && 
                            (getUserRole() in ['standard', 'pro', 'admin']) &&
                            resource.data.userId == request.auth.uid;
    }
  }
}

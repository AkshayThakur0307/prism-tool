rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Get user's role safely (handles missing doc or missing field)
    function getUserRole() {
       let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid));
       return userProfile != null ? userProfile.data.get('role', 'standard') : 'standard';
    }

    // Users Collection: Users can read/write own profile, Admin can read/write ALL
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');
      allow write: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');
    }

    // Projects Collection
    match /projects/{projectId} {
      // READ: Owner OR in sharedEmails list OR Admin
      allow read: if request.auth != null && (
        (resource == null || resource.data.userId == request.auth.uid) || 
        (resource.data.sharedEmails != null && request.auth.token.email in resource.data.sharedEmails) ||
        getUserRole() == 'admin'
      );
      
      // CREATE: Authenticated users with valid role
      // CREATE: Authenticated users can create their own projects
      allow create: if request.auth != null && 
                    request.resource.data.userId == request.auth.uid;

      // UPDATE/DELETE: Owner only OR Admin
      allow update, delete: if request.auth != null && 
                            (getUserRole() in ['standard', 'pro', 'admin']) &&
                            (resource.data.userId == request.auth.uid || getUserRole() == 'admin');
    }
    // System Config (Role Permissions)
    match /systemConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

  }
}
